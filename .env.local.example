# Copy to .env.local (git-ignored) for local dev, and set the same three
# values in Vercel → Project Settings → Environment Variables for
# production. All three come from a Supabase project → Project Settings →
# API, after running supabase-schema-msmk.sql in its SQL Editor.
#
# NEXT_PUBLIC_* values are visible to any visitor — that's expected, the
# anon key only grants what Row Level Security allows (insert-only on
# registrations). SUPABASE_SERVICE_ROLE_KEY is a secret: it bypasses RLS
# entirely, must never be prefixed NEXT_PUBLIC_, and must never be
# committed or logged.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Random long string used to sign the MSMK learner-dashboard session
# cookie. Generate one with: openssl rand -base64 32
MSMK_SESSION_SECRET=
