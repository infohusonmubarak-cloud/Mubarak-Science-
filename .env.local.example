# Copy to .env.local (git-ignored) for local dev, and set the same values
# in Vercel → Project Settings → Environment Variables for production.
#
# The three Supabase values come from a Supabase project → Project
# Settings → API, after running supabase-schema-admin-access.sql,
# supabase-schema-msmk.sql, supabase-schema-main-site.sql, and
# supabase-schema-qa-helper.sql (in that order) in its SQL Editor.
#
# NEXT_PUBLIC_* values are visible to any visitor — that's expected, the
# anon key only grants what Row Level Security allows (insert-only on
# registrations). SUPABASE_SERVICE_ROLE_KEY is a secret: it bypasses RLS
# entirely, must never be prefixed NEXT_PUBLIC_, and must never be
# committed or logged.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Random long string used to sign the MSMK learner-dashboard session
# cookie. Generate one with: openssl rand -base64 32
MSMK_SESSION_SECRET=

# Powers the Ask-a-Question homework helper (/ask, app/api/ask/route.ts).
# From console.anthropic.com -> API Keys. Never commit a real key, and
# never prefix this with NEXT_PUBLIC_ -- it must stay server-only.
ANTHROPIC_API_KEY=

# Optional: how many questions one visitor (by IP) can ask per UTC day
# before the homework helper starts declining. Defaults to 20 if unset.
# Takes effect immediately on save -- no redeploy needed, since it's read
# fresh on every request rather than baked into the build.
QA_DAILY_LIMIT=20
